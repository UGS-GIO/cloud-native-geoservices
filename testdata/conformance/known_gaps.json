{
 "ignore": [
  {"match": [
   "*/error-*: error.message (value)",
   "*/error-*: error.details* (*)"],
   "reason": "Error messages and details are free text; the error code is compared."},
  {"match": [
   "*: fields[*].sqlType (value)"],
   "reason": "Clients do not read sqlType, and AGOL writes sqlTypeOther for almost every field."},
  {"match": [
   "*: fields[*].defaultValue (*)",
   "*: geometryProperties (missing)",
   "*/layer: hasGeometryProperties (missing)"],
   "reason": "The GeoParquet copy keeps values only: no field defaults, and Shape__Area/Shape__Length are plain fields, not AGOL's computed shape fields."},
  {"match": [
   "*/layer: description (value)",
   "*/layer: copyrightText (value)",
   "*/layer: serviceItemId (missing)",
   "*/layer: editingInfo (missing)",
   "*/layer: hasMetadata (missing)",
   "*/layer: cacheMaxAge (missing)",
   "*/layer: indexes (length)",
   "*/layer: templates (length)",
   "*/layer: htmlPopupType (value)",
   "*/layer: infoInEstimates (missing)",
   "*/layer: drawingInfo.*"],
   "reason": "These describe the hosted item: its text, edit history, indexes, popups and default symbol. Symbols here come from renders."},
  {"match": [
   "*/layer: advancedQueryCapabilities.*",
   "*/layer: advancedEditingCapabilities (missing)",
   "*/layer: advancedQueryAnalyticCapabilities (missing)",
   "*/layer: queryBinsCapabilities (missing)",
   "*/layer: capabilities (value)",
   "*/layer: allowGeometryUpdates (value)",
   "*/layer: allowTrueCurvesUpdates (missing)",
   "*/layer: onlyAllowTrueCurveUpdatesByTrueCurveClients (missing)",
   "*/layer: trueCurveSupportMode (missing)",
   "*/layer: supportedCurveTypes (missing)",
   "*/layer: supportedTrueCurvePbfFeatureEncodings (missing)",
   "*/layer: supportedAppend*",
   "*/layer: supportedExportFormats (value)",
   "*/layer: supportedConvert*",
   "*/layer: supportedContingentValuesFormats (value)",
   "*/layer: supportsContingentValues (missing)",
   "*/layer: supportsEditingContingentValues (missing)",
   "*/layer: supportedSyncDataOptions (missing)",
   "*/layer: supportsAppend (value)",
   "*/layer: supportsApplyEditsWithGlobalIds (value)",
   "*/layer: supportsASyncCalculate (value)",
   "*/layer: supportsAttachments* (value)",
   "*/layer: supportsCalculate (value)",
   "*/layer: supportsTruncate (value)",
   "*/layer: supportsRollbackOnFailureParameter (value)",
   "*/layer: supportsValidateSql (value)",
   "*/layer: supportsFieldDescriptionProperty (value)",
   "*/layer: supportsFieldGroups (missing)",
   "*/layer: supportsLayerOverrides (value)",
   "*/layer: supportsQuantizationEditMode (value)",
   "*/layer: supportsColumnStoreIndex (missing)",
   "*/layer: supportsMultiScaleGeometry (missing)",
   "*/layer: supportsReturningQueryGeometry (value)",
   "*/layer: supportsExceedsLimitStatistics (value)",
   "*/layer: collation (missing)",
   "*/layer: supportedOperationsWithCollation (missing)",
   "*/layer: guidFormat (missing)",
   "*/layer: enableNullGeometry (missing)",
   "*/layer: maxIdsCount (missing)",
   "*/layer: fields[*].editable (value)",
   "*/layer: fields[*].precision (missing)"],
   "reason": "Capabilities this server does not implement (editing, curves, attachments, analytics, export, sync, collation). It reports them as unsupported or leaves them out."},
  {"match": [
   "*/layer: extent (value)",
   "*/layer: extent.*min (value)",
   "*/layer: extent.*max (value)"],
   "reason": "AGOL does not refresh a hosted layer's extent (here null, one segment, or an older boundary); returnExtentOnly is compared instead."}
 ],
 "known": [
  {"match": [
   "*/distinct-count: count (value)"],
   "reason": "returnCountOnly with returnDistinctValues counts rows, not distinct values."},
  {"match": [
   "*/features-utm: error (extra)",
   "*/features-utm: * (missing)"],
   "reason": "outSR other than 4326, 4269 and Web Mercator is a 400."},
  {"match": [
   "*/features-subset: fields (order)",
   "*/distinct-two: fields (order)"],
   "reason": "Fields follow the schema order; Esri lists them in outFields order."},
  {"match": [
   "*/pbf: fields (order)"],
   "reason": "f=pbf lists fields in alphabetical order, not schema order."},
  {"match": [
   "*: *spatialReference.latestWkid (missing)"],
   "reason": "f=pbf leaves out latestWkid."},
  {"match": [
   "*: fields[GlobalID].type (value)",
   "*: globalIdFieldName (*)",
   "*/layer: globalIdField (value)"],
   "reason": "A GlobalID field cannot be declared, so it is a string field and globalIdFieldName is empty."},
  {"match": [
   "*: fields[*].length (value)",
   "*/layer: fields[*].nullable (value)"],
   "reason": "GeoParquet has no string lengths, so strings say 128; a GlobalID is a nullable string here."},
  {"match": [
   "*/layer: standardMaxRecordCount (value)",
   "*/layer: standardMaxRecordCountNoGeometry (value)"],
   "reason": "resultType=standard is not supported, so both standard page sizes are maxRecordCount."},
  {"match": [
   "*/layer: supportedSpatialRelationships (length)"],
   "reason": "Only four spatialRel values are supported (README)."}
 ]
}
